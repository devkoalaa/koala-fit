# Postgres connection string.
#
# Production runs on the Oracle server, where DATABASE_URL lives in
# ~/apps/koala-fit/.env (not committed) and points at the "postgres" container.
# For local dev, either run a local Postgres or tunnel to the server's one:
#   ssh -N -L 5433:127.0.0.1:5432 ubuntu@144.22.200.152
# and use postgres://koala_fit:<password>@localhost:5433/koala_fit
DATABASE_URL=
