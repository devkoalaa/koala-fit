# Neon Postgres connection string.
#
# This project uses Vercel's native Neon integration, so DATABASE_URL is
# injected automatically in Preview/Production deployments. For local dev:
#   1. vercel link                    (attach this directory to the Vercel project)
#   2. vercel env pull .env.local     (pulls DATABASE_URL into .env.local, gitignored)
DATABASE_URL=
